<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Sinatra + Redis — Visit Counter</title>
    <link rel="stylesheet" href="/style.css">
  </head>
  <body>
    <main>
      <h1>Visit counter</h1>
      <p>This page has been visited:</p>
      <div class="counter" aria-label="Number of visits">
        <%= visits %>
      </div>
      <p class="hint">Refresh the page to increase the counter.</p>
    </main>
  </body>
</html>
